# Optional. With a key, interaction events (see lib/analytics.ts) also go to
# PostHog, which records custom events on its free tier; Vercel Web Analytics
# only records them on Pro. Without a key nothing PostHog-related is loaded.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Local checks only: lets a driven browser's events through PostHog's bot filter.
# NEXT_PUBLIC_POSTHOG_ALLOW_BOTS=1
